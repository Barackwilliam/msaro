# Copy to .env for local work, or set these on Render (Environment tab).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,msaroguidetanzania.com,www.msaroguidetanzania.com

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase -> Storage -> Settings -> S3 Connection (create an access key there)
SUPABASE_PROJECT_URL=https://YOUR_REF.supabase.co
SUPABASE_S3_ENDPOINT=https://YOUR_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR-REGION
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# A *public* bucket
SUPABASE_STORAGE_BUCKET=media
